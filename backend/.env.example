# TiffinExpress Backend — Environment Variables
# Copy to .env and fill in real values (never commit .env)

PORT=3001

# WhatsApp Business API — get these from Meta developers dashboard
WHATSAPP_TOKEN=your-permanent-access-token
PHONE_NUMBER_ID=your-phone-number-id
WEBHOOK_VERIFY_TOKEN=your-custom-verify-token
SHOP_PHONE=919999999999

# Admin API token — any long random string
ADMIN_API_TOKEN=change-me-to-a-long-random-string
